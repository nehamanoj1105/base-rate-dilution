  "m_grid": [
    0,
    1000,
    2500,
    5000,
    10000,
    25000,
    50000,
    100000
  ],
  "detectors": [
    "rule_hard",
    "rule_all",
    "graphsage_baseline",
    "graphsage_inv_features",
    "gated_sage"
  ],
  "resampling_pool": "BenignResampler.create_default_pool(num_graphs=10, edges_per_graph=2000)",
